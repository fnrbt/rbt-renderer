<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>
  <!-- The rbt-text libraries come from the package registry. -->
  <PropertyGroup>
    <RbtTextPackageVersion Condition="'$(RbtTextPackageVersion)' == ''">0.1.5</RbtTextPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Rbt.OpenType.Core" Version="$(RbtTextPackageVersion)" />
    <PackageReference Include="Rbt.Unicode.Core" Version="$(RbtTextPackageVersion)" />
    <PackageReference Include="Rbt.Shaper.Core" Version="$(RbtTextPackageVersion)" />
    <PackageReference Include="Rbt.Bidi.Core" Version="$(RbtTextPackageVersion)" />
    <PackageReference Include="Rbt.Text.Engine" Version="$(RbtTextPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Pcf.fs" />
    <Compile Include="Text.fs" />
    <Compile Include="Cmd.fs" />
  </ItemGroup>
  <!-- Ship the F# sources under fable/ so Fable can compile this library from
       the NuGet package alone, and the default font browser hosts load. -->
  <ItemGroup>
    <Content Include="$(MSBuildProjectFullPath)" PackagePath="fable/" Pack="true" Visible="false" />
    <Content Include="@(Compile)" PackagePath="fable/%(RelativeDir)" Pack="true" Visible="false" />
    <Content Include="NotoSans-Regular.ttf" PackagePath="assets/" Pack="true" Visible="false" />
  </ItemGroup>
</Project>
